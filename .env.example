APP_NAME="Smart Price Aggregator"

# Local default. For PostgreSQL, use:
# DATABASE_URL="postgresql+psycopg://priceagg:priceagg@localhost:5432/priceagg"
DATABASE_URL="sqlite:///./price_aggregator.db"

CACHE_TTL_SECONDS=180
REQUEST_TIMEOUT_SECONDS=4
DEFAULT_CITY="Hyderabad"
DEFAULT_PINCODE="500001"
CORS_ORIGINS="*"

# Keep false for offline demos. When true, /api/location/search may call Nominatim.
ENABLE_LIVE_LOCATION=false
NOMINATIM_URL="https://nominatim.openstreetmap.org/search"
OSRM_ROUTE_URL="https://router.project-osrm.org/route/v1/driving"
